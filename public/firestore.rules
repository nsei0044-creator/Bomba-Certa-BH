rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function nota(n)  { return n is int && n >= 1 && n <= 5; }
    function media(n) { return n is number && n >= 1 && n <= 5; }
    function mediasOk(m) {
      return m.keys().hasOnly(['atendimento','preco','agilidade','estrutura'])
        && m.keys().hasAll(['atendimento','preco','agilidade','estrutura'])
        && media(m.atendimento) && media(m.preco) && media(m.agilidade) && media(m.estrutura);
    }
    function avaliacaoOk(d) {
      return d.keys().hasOnly(['atendimento','preco','agilidade','estrutura','uid','timestamp'])
        && d.keys().hasAll(['atendimento','preco','agilidade','estrutura','uid','timestamp'])
        && nota(d.atendimento) && nota(d.preco) && nota(d.agilidade) && nota(d.estrutura)
        && d.uid == request.auth.uid && d.timestamp == request.time;
    }

    match /postos/{postoId} {
      allow read: if true;

      // O agregado (votos + médias) só muda junto com a avaliação do próprio usuário,
      // no mesmo lote/transação, e só avança 1 voto por vez.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['votos','notas'])
        && request.resource.data.votos == 1
        && mediasOk(request.resource.data.notas)
        && existsAfter(/databases/$(database)/documents/postos/$(postoId)/avaliacoes/$(request.auth.uid));
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['votos','notas'])
        && request.resource.data.votos == resource.data.votos + 1
        && mediasOk(request.resource.data.notas)
        && !exists(/databases/$(database)/documents/postos/$(postoId)/avaliacoes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/postos/$(postoId)/avaliacoes/$(request.auth.uid));
      allow delete: if false;

      // id da avaliação = uid: uma avaliação por usuário por posto, sem edição nem exclusão
      match /avaliacoes/{avaliacaoId} {
        allow read: if request.auth != null && avaliacaoId == request.auth.uid;
        allow create: if request.auth != null && avaliacaoId == request.auth.uid && avaliacaoOk(request.resource.data);
        allow update, delete: if false;
      }
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
